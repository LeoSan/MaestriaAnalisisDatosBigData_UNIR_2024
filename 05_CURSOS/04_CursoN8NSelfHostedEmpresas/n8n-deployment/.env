# Configuración de Base de Datos (Postgres)
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=postgres
POSTGRES_NON_ROOT_USER=admin
POSTGRES_NON_ROOT_PASSWORD=admin

# Configuración de n8n
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
NODE_ENV=production
GENERIC_TIMEZONE=America/Mexico_City

# Datos de persistencia para n8n
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=15009
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=admin
DB_POSTGRESDB_PASSWORD=admin
